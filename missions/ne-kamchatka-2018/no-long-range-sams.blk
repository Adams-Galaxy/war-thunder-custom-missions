triggers{
  isCategory:b=yes
  is_enabled:b=yes
  add_objectives{
    is_enabled:b=yes
    comments:t=""
    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }
    events{
      initMission{}
    }
    conditions{
      varCompareBool{
        var_value:t="has_strategic_bombers"
        value:b=yes
        comparasion_func:t="equal"
      }
    }
    actions{
      moAddMissionObjective{
        target:t="nuclear_escalation_objective_t1"
      }
      moAddMissionObjective{
        target:t="nuclear_escalation_objective_t2"
      }
    }
    else_actions{
      moAddMissionObjective{
        target:t="destroy_vehicles_and_airfields_t1"
      }
      moAddMissionObjective{
        target:t="destroy_vehicles_and_airfields_t2"
      }
    }
  }
  check_win{
    isCategory:b=yes
    is_enabled:b=yes
    t1_check_win{
      is_enabled:b=yes
      comments:t=""
      props{
        actionsType:t="PERFORM_ONE_BY_ONE"
        conditionsType:t="ALL"
        enableAfterComplete:b=no
      }
      events{
        periodicEvent{
          time:r=0.5
        }
      }
      conditions{
        airfieldWhenStatus{
          object_type:t="isBombingAreaDestroyed"
          object:t="t2_airfield_main"
        }
      }
      actions{
        moSetObjectiveStatus{
          target:t="nuclear_escalation_objective_t1"
          status:i=2
          object_marking:i=0
          object_var_comp_op:t="equal"
          object_var_name:t=""
        }
        triggerEnable{
          target:t="t1_smooth_win"
        }
      }
      else_actions{}
    }
    t1_smooth_win{
      is_enabled:b=no
      comments:t=""
      props{
        actionsType:t="PERFORM_ONE_BY_ONE"
        conditionsType:t="ALL"
        enableAfterComplete:b=yes
      }
      events{
        periodicEvent{
          time:r=2
        }
      }
      conditions{}
      actions{
        gameMPChangeScore{
          value:i=-1
          valueSystem:t="percentage"
          team:t="B"
        }
      }
      else_actions{}
